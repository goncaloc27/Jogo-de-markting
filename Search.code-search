<script>const D={"cfg": {"EMP_NOME": "Âmbar e Sal, Distribuição de Cosmética Profissional, Lda.", "EMP_SETOR": "Distribuição grossista de cosmética e produtos de estética profissional", "EMP_SEDE": "Maia (distrito do Porto)", "EMP_EQUIPA": "[preencher]", "DATA_REF": "2026-06-30 00:00:00", "ANO_BASE": 2025.0, "ANO_META": 2026.0, "META_CRESC": 0.15, "MES_INICIO": 7.0, "IVA": 0.23, "N_PAG": 14.0, "TSU_EP": 0.2375, "SEG_AT": 0.015, "SUB_ALIM_DIA": 9.0, "DIAS_UTEIS_ANO": 220.0, "FV_SAL_BASE": 1250.0, "FV_COMISSAO": 0.03, "FV_VIATURA": 620.0, "FV_AJUDAS": 220.0, "FV_COMUNIC": 45.0, "FV_RECRUT": 2500.0, "FV_FORMACAO": 1800.0, "FV_EQUIP": 1500.0, "FV_CANIB": 0.1, "FV_CUSTO_MENSAL": 2876.5625, "FV_CUSTO_ENTRADA": 5800.0, "FV_PROD_EXPERIENTE": 30902.4346666667, "FV_PROD_C06": 15526.6783333333, "FV_PROD_REF": 15526.6783333333, "FV_RAMPA_1": 0.07, "FV_RAMPA_2": 0.2, "FV_RAMPA_3": 0.35, "FV_RAMPA_4": 0.5, "FV_RAMPA_5": 0.6, "FV_RAMPA_6": 0.7, "FV_RAMPA_7": 0.8, "FV_RAMPA_8": 0.9, "FV_RAMPA_9": 0.95, "FV_RAMPA_10": 1.0, "MKT_COMPRA_NOVO": 580.0, "MKT_RETENCAO_6M": 0.8, "MKT_REND_DECR": 0.15, "MKT_META": 3.0, "MKT_GOOGLE": 2.0, "MKT_EMAIL": 2.0, "MKT_FEIRA": 3.0, "MKT_AMOSTRAS": 2.0, "MKT_INFLU": 2.0, "PRM_ELAST": 2.3, "PRM_ANTECIP": 0.12, "PRM_CUSTO_FIXO": 900.0, "PRM_DESC_MAX": 0.3, "MARG_BRUTA": 0.455030765242338, "CF_RENDAS": 5350.0, "CF_ENERGIA": 1150.0, "CF_COMUNIC": 780.0, "CF_SEGUROS": 420.0, "CF_OUTROS": 950.0, "CF_FROTA_LOG": 750.0, "TRANSP_PCT": 0.025, "PMR": 45.0, "CUSTO_PESSOAL_MES": 50609.2021125}, "h24": [130972.16, 136137.08, 161402.06, 173124.95, 203523.89, 205453.81, 189672.28, 120164.94, 165334.93, 164704.06, 217445.85, 227158.18], "h25": [133254.99, 139062.29, 164116.96, 188659.52, 204591.06, 196834.19, 203922.98, 130554.38, 189749.15, 189301.54, 248261.87, 250165.23], "h26": [137548.77, 148094.68, 174348.12, 189346.6, 216489.35, 210323.06], "cats": ["Barbearia", "Cabelo", "Cofres de oferta", "Cuidado de corpo", "Cuidado de rosto", "Estética profissional", "Maq