 +(saved.length?'<tr><td></td>'+saved.map((x,i)=>'<td>'+(canDel(i)?`<button onclick="delSc(${i})">Apagar</button>`:'')).join('')+'</tr>':'')};
window.cmp=cmp;
window.tab=i=>{document.querySelectorAll('.pg').forEach((e,j)=>e.style.display=j==i?'block':'none');document.querySelectorAll('nav button').forEach((e,j)=>e.className=j==i?'on':'');if(i==4)upd();if(i==7)$('tx').value=snap()};
const fs$=(t,ok)=>{$('fs').textContent=t;$('fs').className='fs '+(ok?'ok':'ko')};
const save=async(name,data)=>{try{const d=window.claude&&await claude.use('downloads');if(!d)return fs$('Neste ambiente não é possível gravar ficheiros. Use «Configuração em texto» para copiar.');await d.save({filename:name,data});fs$('Ficheiro «'+name+'» pronto.',1)}catch(e){fs$(e&&e.code=='declined'?'Gravação cancelada.':'Não foi possível gravar o ficheiro ('+(e&&e.code||'erro')+').')}};
const snap=()=>JSON.stringify({v:1,c,s,hist:{h24:D.h24,h25:D.h25,h26:D.h26,cats:D.cats,catM:D.catM,catW:D.catW,catMg:D.catMg,mkcor:D.mkcor,mk:D.mk,com:D.com}});
const impJ=t=>{try{const o=JSON.parse(t);if(!o.c||!o.s)throw 0;if(o.hist)Object.assign(D,o.hist);CH.splice(0,CH.length,...Object.keys(D.mk));c=o.c;s=o.s;buildAll();fs$('Configuração importada e simulador atualizado.',1)}catch(e){fs$('Ficheiro inválido: use um JSON exportado por este simulador.')}};
const impX=async f=>{if(!window.XLSX)return fs$('A biblioteca de Excel não carregou (ambiente sem acesso à internet).');
 try{const wb=XLSX.read(await f.arrayBuffer(),{type:'array',cellDates:true}),J=n=>{if(!wb.Sheets[n])throw n;return XLSX.utils.sheet_to_json(wb.Sheets[n])},cf=XLSX.utils.sheet_to_json(wb.Sheets.Configuracao||(()=>{throw'Configuracao'})(),{header:1}),P={},r2=v=>Math.round(v*100)/100;
  cf.forEach(r=>{if(typeof r[0]=='string'&&/^[A-Z][A-Z0-9_]+$/.test(r[0])&&r[2]!=null)P[r[0]]=typeof r[2]=='number'?r[2]:String(r[2])});
  ['RH_GER','RH_DIRCOM','RH_VINT','RH_MKT','RH_LOG','RH_FIN'].forEach((k,i)=>{const r=cf.find(x=>x[0]==k);if(r){DEP[i][1]=r[2];DEP[i][2]=r[3]}});
  const mk={};cf.forEach(r=>{if(/^MKT_/.test(r[0])&&typeof r[6]=='number'&&typeof r[1]=='string')mk[r[1]]={cpl:r2(r[6]),conv:r[7],orc:Math.round(r[9])}});if(Object.keys(mk).length)D.mk=mk;
  Object.assign(D.cfg,P);const yb=+D.cfg.ANO_BASE,ym=+D.cfg.ANO_META,V='Valor líquido (€, sem IVA)',yr={};
  J('Encomendas').forEach(r=>{(yr[r['Ano']]=yr[r['Ano']]||Array(12).fill(0))[r['Mês']-1]+=r[V]||0});
  if(!yr[yb]||!yr[yb-1]||!yr[ym])throw 'anos em falta nas Encomendas';
  D.h24=yr[yb-1].map(r2);D.h25=yr[yb].map(r2);let n=12;while(n>0&&!(yr[ym][n-1]>0))n--;D.h26=yr[ym].slice(0,n).map(r2);
  const cm={},mg={},ft={};J('Linhas_Encomenda').forEach(r=>{if(r['Ano']!=yb)return;const k=r['Categoria'];(cm[k]=cm[k]||Array(12).fill(0))[r['Mês']-1]+=r[V]||0;mg[k]=(mg[k]||0)+(r['Margem bruta (€)']||0);ft[k]=(ft[k]||0)+(r[V]||0)});
  const cats=Object.keys(cm).sort(),tot=sum(cats.map(k=>ft[k]));D.cats=cats;D.catM=cats.map(k=>cm[k].map(Math.round));D.catW=cats.map(k=>ft[k]/tot);D.catMg=cats.map(k=>mg[k]/ft[k]);
  D.com=J('Comerciais').filter(r=>r['Código']!='INT').map(r=>({c:r['Código'],sal:r['Salário base mensal (€)'],cm:r['Comissão sobre vendas (%)'],vi:r['Viatura e combustível (€/mês)'],f25:r['Faturação '+yb+' (€)']||0}));
  D.mkcor=sum(J('Campanhas_Marketing').filter(r=>{const y=new Date(r['Data de início']).getFullYear();return y==yb||y==yb-1}).map(r=>r['Investimento (€)']))/2;
  D.cfg.MES_INICIO=Math.max(+D.cfg.MES_INICIO||7,D.h26.length+1);CH.splice(0,CH.length,...Object.keys(D.mk));c=cfg0();s=sc0(c.mi);buildAll();
  fs$('Excel importado: '+D.h26.length+' meses de '+ym+', '+cats.length+' categorias e '+D.com.length+' comerciais.',1)}catch(e){fs$(typeof e=='string'?'Ficheiro sem a estrutura esperada ('+e+').':'Não foi possível ler o Excel. Use um ficheiro com a mesma estrutura do original.')}};
window.impX=impX;
const n2=v=>typeof v=='number'?v.toFixed(2).replace('.',','):v,HD=['Mês','Ano base real','Ano da meta real','Cenário base','P1','P2','P3','Simulado','Meta mensal'];
const mrows=()=>window.R.mon.map(x=>[MN[x.m-1],D.h25[x.m-1],D.h26[x.m-1]??'',x.base,x.p1,x.p2,x.p3,x.sim,x.meta]);
const csv=()=>save('simulador_mensal.csv','\ufeff'+[HD].concat(mrows().map(a=>a.map(n2))).map(a=>a.join(';')).join('\n'));
const xl=()=>{if(!window.XLSX)return fs$('A biblioteca de Excel não carregou. Use a exportação CSV.');const r=window.R,k=r.k,pp=['var','distp'],A=XLSX.utils.aoa_to_sheet,wb=XLSX.utils.book_new(),ad=(a,n)=>XLSX.utils.book_append_sheet(wb,A(a),n);
 ad([['Empresa',c.p.EMP_NOME],['Meta de faturação (€)',r.meta],['Faturação sem medidas (€)',r.fatBase],['Desvio a cobrir (€)',r.desvio],['Trabalhadores',r.nT],['Custo anual com pessoal (€)',r.pers],['Custos fixos mensais (€)',r.cf],['Margem bruta ponderada (%)',r.mp*100],['Meta atingida',k.fat>=r.meta?'Sim':'Não'],[],['Indicador','Valor']].concat(KL.map(x=>[x[1]+(pp.includes(x[0])?' (%)':''),pp.includes(x[0])?k[x[0]]*100:k[x[0]]])),'Resumo');
 ad([HD].concat(mrows()),'Mensal');
 ad([['Medida','Detalhe','Valor']].concat(s.p1.filter(v=>v.n>0).map((v,i)=>['P1 vaga '+(i+1),MN[v.h-1],v.n+' comerciais']),s.p2.filter(v=>v.b>0).map(v=>['P2 '+v.ch,MN[v.t-1],v.b]),s.p3.filter(v=>v.d>0).map((v,i)=>['P3 promoção '+(i+1),MN[v.t-1]+', '+v.n+' mês(es): '+v.cats.map(j=>D.cats[j]).join(', '),v.d*100+'%'])),'Medidas');
 if(saved.length)ad([['Indicador'].concat(saved.map(x=>x.n))].concat(KL.map(l=>[l[1]].concat(saved.map(x=>x.k[l[0]])))),'Cenários guardados');
 save('simulador_resultados.xlsx',XLSX.write(wb,{bookType:'xlsx',type:'array'}))};
const pick=f=>{if(!f)return;if(/\.json$/i.test(f.name))f.text().then(impJ);else if(/\.xls[xm]$/i.test(f.name))impX(f);else fs$('Formato não suportado: use .json ou .xlsx.')};
$('fi').onchange=e=>{pick(e.target.files[0]);e.target.value=''};
const dz=$('dz');dz.onclick=()=>$('fi').click();['dragover','dragenter'].forEach(t=>dz.addEventListener(t,e=>{e.preventDefault();dz.classList.add('dv')}));['dragleave','drop'].forEach(t=>dz.addEventListener(t,e=>{e.preventDefault();dz.classList.remove('dv')}));dz.addEventListener('drop',e=>pick(e.dataTransfer.files[0]));
$('bj').onclick=()=>save('simulador_configuracao.json',snap());$('bx').onclick=xl;$('bc').onclick=csv;$('bt').onclick=()=>impJ($('tx').value);
$('bcp').onclick=async()=>{try{await navigator.clipboard.writeText($('tx').value)}catch(e){$('tx').select();document.execCommand('copy')}fs$('Configuração copiada.',1)};
buildAll();tab(0);
}
</script>
<script>(async()=>{
const $=id=>document.getElementById(id),esc=s=>String(s).replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';'),norm=u=>u.trim().toLowerCase(),wait=ms=>new Promise(r=>setTimeout(r,ms));
const enc=new TextEncoder(),b64=u=>btoa(String.fromCharCode(...u)),unb=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
const hash=async(pw,salt)=>b64(new Uint8Array(await crypto.subtle.deriveBits({name:'PBKDF2',hash:'SHA-256',salt,iterations:150000},await crypto.subtle.importKey('raw',enc.encode(pw),'PBKDF2',false,['deriveBits']),256)));
// ----- CONFIGURAÇÃO DO FIREBASE: substitua pelos valores do seu projeto -----
// Consola Firebase > Definições do projeto > Geral > As suas apps > Configuração do SDK
const firebaseConfig={apiKey:"AIzaSyCm5P-H3WGiVIYjUK1oUmb5WaPAIQhhmpA",authDomain:"simulador-79d24.firebaseapp.com",projectId:"simulador-79d24",storageBucket:"simulador-79d24.firebasestorage.app",messagingSenderId:"272960377646",appId:"1:272960377646:web:e5c0e8237f68f17c80a0bf"};
const EMAIL_DOMAIN='equipa-simulador.app'; // domínio fictício: o login continua a ser por nome de utilizador, não por email
const toEmail=u=>u+'@'+EMAIL_DOMAIN;
// -----------------------------------------------------------------------------
firebase.initializeApp(firebaseConfig);
const auth=firebase.auth(),dbf=firebase.firestore();
let me=null,mode=0,setup=false,busy=false,registering=false;
const say=(t,ok)=>{$('gm').textContent=t;$('gm').className=ok?'ok':'ko'};
window.gt=m=>{mode=m;$('t1').className=m?'':'on';$('t2').className=m?'on':'';document.querySelectorAll('.rg').forEach(e=>e.style.display=m?'flex':'none');$('go').textContent=m?'Criar utilizador':'Entrar';$('lcs').textContent=setup?'Defina o código da equipa (os colegas vão precisar dele)':'Código da equipa (pedir a um colega)';say('')};

function enter(uid,x){me={uid,u:x.handle,name:x.name||x.handle,role:x.role};window.me=me;window.userRole=me.role;
 document.body.classList.remove('locked');$('lp').value=$('lp2').value=$('lc').value='';say('');
 $('ub').innerHTML=`<span>Sessão de <b>${esc(me.name)}</b>${me.role=='master_admin'?' (Admin Master)':''}</span><span><button id=bu data-role-gate="master_admin">Utilizadores</button> <button id=bo>Sair</button></span>`;
 $('bo').onclick=()=>auth.signOut();
 $('bu').onclick=async()=>{if(!$('up').hidden){$('up').hidden=true;return}await users();$('up').hidden=false};
 updateUIBasedOnRole(me.role);
 if(window.tab)tab(0);if(window.upd)upd()}

// Regra 3: mostra/esconde elementos marcados com data-role-gate="<role>" consoante o role atual.
// Hoje só o botão "Utilizadores" usa esta marca; para criar separadores futuros como
// "Administração" ou "Definições", basta acrescentar o mesmo atributo ao elemento.
function updateUIBasedOnRole(role){
 document.querySelectorAll('[data-role-gate]').forEach(el=>{el.style.display=(role===el.dataset.roleGate)?'':'none'});
 if(window.cmp)window.cmp(); // re-renderiza a tabela de cenários para atualizar os botões de apagar
}

async function users(){try{const q=await dbf.collection('users').get();
 const rl={master_admin:'Admin Master',visitor:'visitante'};
 $('up').innerHTML='<div class=card><h3>Utilizadores com acesso</h3>'+q.docs.map(d=>{const x=d.data();return `<div class=ur><span>${esc(x.name)} (${esc(x.handle)}), ${esc(rl[x.role]||x.role)}</span>${d.id!==me.uid?`<button data-u="${esc(d.id)}">Remover</button>`:''}</div>`}).join('')
  +'</div><p class=n>Remover revoga o acesso à base de dados; se quiser apagar também a conta de autenticação, faça-o na consola Firebase &gt; Authentication.</p>'}
 catch(e){$('up').innerHTML='<p class=n>Sem permissão para listar utilizadores.</p>'}}
$('up').onclick=async e=>{const u=e.target.dataset&&e.target.dataset.u;if(u&&confirm('Remover o acesso deste utilizador?')){try{await dbf.doc('users/'+u).delete();await users()}catch(x){say('Não foi possível remover.')}}};

async function login(){const u=norm($('lu').value),p=$('lp').value;
 try{await auth.signInWithEmailAndPassword(toEmail(u),p)}
 catch(e){await wait(800);say('Nome de utilizador ou palavra-passe incorretos.')}}

async function reg(){const u=norm($('lu').value),p=$('lp').value,c=$('lc').value;
 if(!/^[a-z0-9._-]{3,24}$/.test(u))return say('Nome de utilizador: 3 a 24 caracteres (letras, números, ponto, hífen ou _).');
 if(p.length<8)return say('A palavra-passe deve ter pelo menos 8 caracteres.');
 if(p!==$('lp2').value)return say('As palavras-passe não coincidem.');
 if(!c)return say('Indique o código da equipa.');
 try{
  // Regra 1 — Registo Inteligente: query à coleção users (limite 1) ANTES de gravar.
  // Coleção vazia → este utilizador é o 'master_admin'; caso contrário → 'visitor'.
  const first=(await dbf.collection('users').limit(1).get()).empty,t=await dbf.doc('meta/team').get();let admin=false;
  if(first&&!t.exists){admin=true}
  else{if(!t.exists)return say('Falta o código da equipa. Peça ao administrador.');const x=t.data();if(await hash(c,unb(x.salt))!==x.hash){await wait(800);return say('Código da equipa incorreto.')}}
  registering=true;
  const cred=await auth.createUserWithEmailAndPassword(toEmail(u),p);
  if(admin){const s=crypto.getRandomValues(new Uint8Array(16));await dbf.doc('meta/team').set({salt:b64(s),hash:await hash(c,s)})}
  const rec={handle:u,name:$('ln').value.trim()||u,role:admin?'master_admin':'visitor',created:new Date().toISOString()};
  await dbf.doc('users/'+cred.user.uid).set(rec);setup=false;enter(cred.user.uid,rec)
 }catch(e){
  const m=e&&e.code=='auth/email-already-in-use'?': esse nome de utilizador já existe.':e&&e.code=='auth/weak-password'?': palavra-passe demasiado fraca para o Firebase.':'';
  say('Não foi possível criar o utilizador'+m+(m?'':' ('+(e&&e.code||'erro')+').'))}
 finally{registering=false}}

$('go').onclick=async()=>{if(busy)return;busy=true;$('go').disabled=true;await(mode?reg():login());busy=false;$('go').disabled=false};
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&document.body.classList.contains('locked'))$('go').click()});

auth.onAuthStateChanged(async user=>{
 if(!user){me=null;window.me=null;window.userRole=null;document.body.classList.add('locked');$('up').hidden=true;updateUIBasedOnRole(null);return}
 if(registering)return; // reg() escreve o perfil e entra diretamente, para evitar corrida com esta verificação
 // Regra 2 — Leitura de Permissões no Login: getDoc do utilizador em "users" para extrair o role.
 try{const d=await dbf.doc('users/'+user.uid).get();
  if(!d.exists){say('A sua conta foi removida pelo administrador.');await auth.signOut();return}
  enter(user.uid,d.data()) // guarda o role em window.me.role / window.userRole e chama updateUIBasedOnRole()
 }catch(e){say('Não foi possível validar a sessão. Verifique a ligação à internet.')}});

try{setup=(await dbf.collection('users').limit(1).get()).empty}catch(e){say('Não foi possível ligar à base de dados Firebase. Confirme firebaseConfig e as regras do Firestore.')}
gt(setup?1:0);if(setup)say('Ainda não há utilizadores: crie o primeiro (será o Admin Master).',1);
})();
</script></body></html>