const canDel=i=>window.me&&(window.me.role==='master_admin'||window.me.u===saved[i].c);
window.delSc=i=>{if(!canDel(i))return;if(!confirm('Remover o cenário «'+saved[i].n+'»?'))return;saved.splice(i,1);cmp()};
const cmp=()=>{$('cmpT').innerHTML='<tr><th>Indicador'+saved.map(x=>'<th>'+x.n+'<br><small class=n>por '+x.c+'</small>').join('')+'</tr>'
 +KL.map(l=>`<tr><td>${l[1]}`+saved.map(x=>'<td>'+l[2](x.k[l[0]])).join('')+'</tr>').join('')
