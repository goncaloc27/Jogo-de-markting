:root[data-theme="dark"]{--bg:#10171a;--cd:#182126;--soft:#111a1e;--fg:#e6ecee;--mu:#8fa0a8;--bd:#2a373d;--hero:#0c2027;--ac:#56b6c9;--am:#f0b84a;--ok:#4cc38a;--ko:#ff8f78}
