 $('hn').textContent=p.EMP_NOME;$('hs').textContent=p.EMP_SETOR+', sede em '+p.EMP_SEDE;$('gv').textContent=eur(r.desvio);
 $('gs').innerHTML=ok?`<b>Meta atingida</b> com as medidas (excedente de ${eur(-k.dist)})`:`Com as medidas simuladas ainda faltam <b>${eur(k.dist)}</b>`;
 $('gp').innerHTML=`<div class=trk><i style="width:${ps*100}%"></i><u style="left:${pb*100}%"></u></div><div class=tls><span>Sem medidas: ${pc(r.fatBase/r.meta)}</span><span>Com medidas: ${pc(k.atg)}</span><span>Meta: ${eur(r.meta)}</span></div>`;
 $('dash').innerHTML='<h2>A empresa</h2><div class=tg>'+tile('Trabalhadores',r.nT,(r.nT-c.com.length)+' nos departamentos e '+c.com.length+' comerciais')+tile('Custo anual com pessoal',eur(r.pers),eur(r.pers/12)+' por mês')+tile('Custos fixos mensais',eur(r.cf),eur(r.cf*12)+' por ano')+tile('Gastos operacionais anuais',eur(r.gasto),'estimativa do ano da meta')+tile('Margem bruta',pc(r.mp),'média ponderada')+`</div><h2>Meta e resultado de ${p.ANO_META}</h2><div class=tg>`+tile('Meta de faturação',eur(r.meta),'+'+pc(c.meta)+' face a '+p.ANO_BASE)+tile('Faturação sem medidas',eur(r.fatBase),'crescimento homólogo de '+pc(r.g))+tile('Resultado operacional sem medidas',eur(k.opSem))+tile('Resultado operacional com medidas',eur(k.opCom),'',k.opCom<k.opSem?'bad':'good')+tile('Efeito das medidas no resultado',eur(k.res),'',k.res<0?'bad':'good')+'</div>';
 $('bar').innerHTML=`<b class="${ok?'ok':'ko'}">${ok?'Meta atingida':'Meta não atingida'}</b> (${pc(k.atg)} da meta), ${ok?'excedente de '+eur(-k.dist):'faltam '+eur(k.dist)}`;
 $('kp').innerHTML=r.warn.map(w=>`<p class=w>⚠ ${w}</p>`).join('')+KG.map(g=>`<h2>${g[0]}</h2><div class=tg>`+g[1].map(id=>{const v=k[id];return tile(kl[id][1],kl[id][2](v),'',NEG.includes(id)?(v<0?'bad':'good'):(id=='dist'||id=='distp'?(v>0?'bad':'good'):''))}).join('')+'</div>').join('')+'<p class=n>A combinação soma os efeitos das três alavancas (pressuposto de aditividade).</p>';
 [1,2,3].forEach((n,i)=>{const e=$('i'+n),l=r.lev[i];if(e)e.innerHTML=`<b>Impacto desta alavanca:</b> ${l.f>=0?'+':''}${eur(l.f)} de faturação, custos de ${eur(l.c)}${i==2?', desconto concedido de '+eur(k.desc):''}, resultado de ${eur(l.m-l.c-tr*l.f)}.`});
 $('tb').innerHTML='<tr><th>Mês<th>Base<th>P1<th>P2<th>P3<th>Simulado<th>Necessário</tr>'+r.mon.map(x=>`<tr><td>${MN[x.m-1]}<td>${eur(x.base)}<td>${eur(x.p1)}<td>${eur(x.p2)}<td>${eur(x.p3)}<td>${eur(x.sim)}<td>${x.m>=c.mi?eur(x.meta):'—'}</tr>`).join('');
 if(window.Chart){Chart.defaults.color=getComputedStyle(document.body).color;Chart.defaults.font.family='Manrope,system-ui,sans-serif';
  const d=[D.h25,D.h26.concat(Array(12-D.h26.length).fill(null)),r.mon.map(x=>x.base),r.mon.map(x=>x.sim),r.mon.map(x=>x.meta)],nm=['Ano base real','Ano da meta real','Cenário base','Simulado','Meta mensal'],co=['#8a9aa2','#1f7a8c','#e0a030','#1f8a5b','#c4432b'],dh=[[],[],[5,4],[],[2,4]],w=[1.5,2.5,2,3.5,2];
  if(ch)ch.destroy();ch=new Chart($('cv'),{type:'line',data:{labels:MN,datasets:d.map((v,i)=>({label:nm[i],data:v,borderColor:co[i],backgroundColor:co[i],borderWidth:w[i],borderDash:dh[i],pointRadius:i==3?3:1,tension:.25}))},options:{maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom',labels:{usePointStyle:true,boxWidth:8}}},scales:{y:{ticks:{callback:v=>v/1000+' k€'}}}}})}}
const SET={A:()=>{s=sc0(c.mi);s.p1[0]={n:2,h:c.mi}},B:()=>{s=sc0(c.mi);s.p2[0]={ch:CH.find(k=>k.includes('Meta')),b:c.mk[CH.find(k=>k.includes('Meta'))].orc,t:9};const f=CH.find(k=>k.includes('Feira'));s.p2[1]={ch:f,b:c.mk[f].orc,t:10}},C:()=>{s=sc0(c.mi);s.p3[0]={d:.15,t:11,n:2,cats:D.cats.map((_,j)=>j)}},D:()=>{const a=sc0(c.mi);SET.A();const x=s.p1;SET.B();const y=s.p2;SET.C();s.p1=x;s.p2=y},E:()=>{SET.D();c.dep.forEach(d=>d.s*=1.05);c.com.forEach(x=>x.sal*=1.05);c.mg=c.mg.map(m=>m-.01)}};
window.pre=k=>{if(k!='E'||true){c=cfg0()}SET[k]();buildAll()};
